# ============================================================
# TEMPLATE ENV — OJE ATV KALIURANG
# Salin file ini menjadi .env.local dan isi dengan data Anda
# File .env.local TIDAK boleh di-commit ke Git (.gitignore sudah handle ini)
# ============================================================

# ── WhatsApp & Telepon (tampil di website) ──────────────────────────────────
# Nomor admin penerima booking (format internasional, tanpa +, tanpa spasi)
NEXT_PUBLIC_WA_NUMBER=628XXXXXXXXXX

# Nomor tampilan di website (format lokal)
NEXT_PUBLIC_PHONE_DISPLAY=08XXXXXXXXXX

# Nomor untuk link tel:
NEXT_PUBLIC_PHONE_HREF=08XXXXXXXXXX

# ── Supabase (Database) ─────────────────────────────────────────────────────
# Dari: Supabase Dashboard > Settings > API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXX...

# ⚠️ PENTING: SERVICE_ROLE_KEY bersifat RAHASIA — jangan expose ke browser
# Jangan pakai prefix NEXT_PUBLIC_ untuk variabel Supabase ini!

# ── Resend (Email Notifikasi) ────────────────────────────────────────────────
# Dari: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXX

# Email pengirim (harus sudah diverifikasi domain di Resend)
# Jika domain belum diverifikasi, gunakan: onboarding@resend.dev (untuk test)
RESEND_FROM_EMAIL=booking@ojeatvkaliurang.com

# Email admin penerima notifikasi booking baru
ADMIN_EMAIL=admin@ojeatvkaliurang.com

# ── Google Sheets Webhook (Otomatis ke Google Drive / Excel) ────────────────
# URL Web App deployment dari Google Apps Script (harus https://script.google.com/macros/...)
# JANGAN pakai prefix NEXT_PUBLIC_ — biarkan hanya di server!
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Secret acak minimal 32 karakter (HARUS sama dengan WEBHOOK_SECRET di Google Apps Script)
GOOGLE_SHEETS_SECRET=ganti_dengan_token_acak_minimal_32_karakter
